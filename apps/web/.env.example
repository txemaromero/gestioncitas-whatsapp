# ─── ClinicAI admin panel (apps/web) ─────────────────────────────────────────────────────
# Copy to apps/web/.env.local. Never commit real secrets.

# Database (Supabase pooled URL in production; local: pnpm db:local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clinicai
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/clinicai
# F19: restricted role with row level security per clinic (`pnpm db:app-role` prints it locally;
# Supabase: user clinicai_app.<project-ref>, see docs/deploy.md). Empty: owner connection, code-only isolation.
DATABASE_APP_URL=

# Kinde (Settings → Applications → <your app> → Details). Passwordless email + code:
# Settings → Environment → Authentication → Passwordless → "Email connections > Code" → Configure.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your_subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Same key as the bot: encrypts the per-tenant WhatsApp tokens (32 bytes, base64)
ENCRYPTION_KEY=

# Optional: link shown in Settings → "Abrir Chatwoot"
NEXT_PUBLIC_CHATWOOT_URL=

# F25: only if the Content Security Policy breaks something in production: browsers then report
# violations instead of blocking them (see docs/deploy.md). Remove it once fixed.
# CSP_REPORT_ONLY=true

# F32: WhatsApp numbers saved by a clinic are checked with Meta (Graph API). `mock` skips the check
# (development only; never in Netlify: leave it empty there). META_GRAPH_VERSION defaults to v27.0, like the bot.
WHATSAPP_MODE=mock
# META_GRAPH_VERSION=v27.0
# F32: in production the panel refuses to start without DATABASE_APP_URL unless this is true.
# ALLOW_OWNER_CONNECTION=true

# F31: platform console (/plataforma): Kinde emails of the platform administrators, comma separated.
# Anyone else gets a 404. Empty: nobody can open it.
PLATFORM_ADMIN_EMAILS=
# Optional: prices in USD for the cost estimate, over the defaults (shared/usage.ts). Example:
# PLATFORM_PRICES={"llm":{"other-model":{"input":0.5,"output":1.5}},"transcriptionPerMinute":{"other-transcribe":0.004},"whatsapp":{"template":0.02,"service":0.02,"serviceFreePerMonth":1000}}

# e2e ONLY (never in Netlify): mocks the logged-in user server-side
# AUTH_MOCK_USER=kp_e2e_admin:admin@e2e.test
