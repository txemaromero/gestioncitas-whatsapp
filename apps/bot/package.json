{
  "name": "@clinicai/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "simulate": "tsx --env-file-if-exists=.env src/cli/simulate.ts",
    "preflight": "tsx --env-file-if-exists=.env src/cli/preflight.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clinicai/db": "workspace:*",
    "@clinicai/shared": "workspace:*",
    "fastify": "5.12.8",
    "node-cron": "4.6.0",
    "pino": "10.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
