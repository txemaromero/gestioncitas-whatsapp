# ─── ClinicAI bot (apps/bot) ──────────────────────────────────────────────────────────────
# Copy to apps/bot/.env. Never commit real secrets.

PORT=3008
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace | silent

# Database (Supabase): pooled URL (pgbouncer, port 6543) for the app; DIRECT_URL is used by migrations.
# Local: postgresql://postgres:postgres@localhost:5433/clinicai  (pnpm db:local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clinicai
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/clinicai
# F19: restricted role with row level security per clinic (`pnpm db:app-role` prints it locally;
# Supabase: user clinicai_app.<project-ref>, see docs/deploy.md). Empty: owner connection, code-only isolation.
# F32: required with NODE_ENV=production unless ALLOW_OWNER_CONNECTION=true.
DATABASE_APP_URL=

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────────────────
WHATSAPP_MODE=mock             # live | mock (mock = messages printed in the console, no Meta calls)
META_GRAPH_VERSION=v27.0       # latest Graph API version on 2026-11-10 (check developers.facebook.com/docs/graph-api/changelog)
META_JWT_TOKEN=                # global access token (used when the tenant has no token of its own)
META_APP_SECRET=               # App secret: validates X-Hub-Signature-256 (required in live mode)
VERIFY_TOKEN=                  # any random string, also typed in Meta → Webhooks (required in live mode)
NUMBER_ID=                     # default phone_number_id (development / seed only)
WA_REMINDER_TEMPLATE=recordatorio_cita
WA_WAITLIST_TEMPLATE=aviso_hueco_libre   # F17: waiting list offer (see docs/meta-template.md)
WA_TEMPLATE_LANGUAGE=es
# Only for `pnpm preflight` (F20): WhatsApp Business Account id (WhatsApp Manager) and Meta app id
# (App Settings → Basic). They let it check the templates and the webhook subscription.
META_WABA_ID=
META_APP_ID=
ENCRYPTION_KEY=                # 32 random bytes in base64 (same as the web): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ─── Reminders (RF-W4) ───────────────────────────────────────────────────────────────────
REMINDER_CRON="*/15 * * * *"   # every 15 minutes (each clinic sends at its own hour)…
REMINDER_CRON_TZ=Europe/Madrid # …in this time zone
ENABLE_CRON=true               # set false if an external scheduler calls POST /jobs/reminders/run
CRON_SECRET=                   # header x-cron-secret for POST /jobs/reminders/run and /jobs/waitlist/run

# ─── Waiting list (F17, enabled per clinic in Ajustes) ───────────────────────────────────
WAITLIST_CRON="*/5 * * * *"    # how often freed slots are offered (also right after WhatsApp cancellations)
WAITLIST_OFFER_MINUTES=30      # time to answer an offer before it goes to the next client

# ─── LLM ─────────────────────────────────────────────────────────────────────────────────
LLM_MODE=mock                  # live | mock (mock = deterministic rules, no API key needed)
AI_PROVIDER=openai             # openai | deepseek
ENABLE_FALLBACK=false          # if the primary provider fails, try FALLBACK_PROVIDER
FALLBACK_PROVIDER=openai       # openai (another model, OPENAI_FALLBACK_MODEL) | deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini       # ⚠ OpenAI retires gpt-4o-mini on 2027-01-14 (announced successor: gpt-6-luna)
OPENAI_FALLBACK_MODEL=         # another OpenAI model, validated with eval/ before using it
OPENAI_BASE_URL=https://api.openai.com/v1   # EU data residency: https://eu.api.openai.com/v1 (see docs/rgpd.md)
# DeepSeek: only as AI_PROVIDER=deepseek or FALLBACK_PROVIDER=deepseek. GDPR: Chinese provider,
# the clients' messages leave the EEA (international transfer, see docs/rgpd.md).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=15000
# Voice notes (F16): transcribed with OpenAI (needs OPENAI_API_KEY, also with AI_PROVIDER=deepseek).
# The audio is never stored. whisper-1 / gpt-4o-*-transcribe shut down on 2027-02-26.
VOICE_NOTES=true
VOICE_MAX_SECONDS=120          # longer notes get "please send a shorter one or write"
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# ─── Chatwoot (optional human handoff, RF-W5) ────────────────────────────────────────────
CHATWOOT_URL=                  # e.g. https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_TOKEN=                # user/agent access token (Profile → Access Token)
CHATWOOT_INBOX_NAME=           # name of the API-channel inbox
CHATWOOT_WEBHOOK_SECRET=       # webhook secret (HMAC) or ?token= value in the webhook URL

# ─── Abuse protection ────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20       # messages per phone and minute (counted in the DB: all instances)

# ─── Durable inbound queue (F11) ─────────────────────────────────────────────────────────
QUEUE_CONCURRENCY=4            # conversations processed in parallel per instance
QUEUE_MAX_ATTEMPTS=5           # attempts per event before it is marked as failed
