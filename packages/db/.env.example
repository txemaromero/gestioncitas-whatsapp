# Used by Prisma CLI (migrate/seed) and by scripts in this package.
# Local (embedded, `pnpm db:local`): postgresql://postgres:postgres@localhost:5433/clinicai
# Local (docker compose):           postgresql://postgres:postgres@localhost:5432/clinicai
# Supabase: DATABASE_URL = pooled URL (port 6543, ?pgbouncer=true), DIRECT_URL = direct URL (port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clinicai
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/clinicai

# Optional seed settings
# NUMBER_ID=                 # Meta phone_number_id for the FisioDemo demo tenant (default: mock-fisiodemo)
# SEED_KINDE_USER_ID=        # your Kinde user id (kp_...) to become owner of FisioDemo in the web panel
# SEED_KINDE_EMAIL=
